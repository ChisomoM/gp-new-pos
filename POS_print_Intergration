### 3c. `lib/features/Home/screens/printer_settings/printer_settings_screen.dart`

```dart
import 'package:flutter/material.dart';
import 'package:print_bluetooth_thermal/print_bluetooth_thermal.dart';
import 'package:pos_mobile/common/appbar/appbar.dart';
import 'package:pos_mobile/utils/constants/sizes.dart';
import 'package:pos_mobile/utils/helpers/bluetooth_printer_helper.dart';
import 'package:pos_mobile/utils/helpers/printer_preference.dart';

class PrinterSettingsScreen extends StatefulWidget {
  const PrinterSettingsScreen({super.key});

  @override
  State<PrinterSettingsScreen> createState() => _PrinterSettingsScreenState();
}

class _PrinterSettingsScreenState extends State<PrinterSettingsScreen> {
  late PrinterChoice _printerChoice;
  late PrintBothMode _bothMode;
  String? _selectedMac;
  List<BluetoothInfo> _pairedDevices = [];
  bool _loadingDevices = false;

  @override
  void initState() {
    super.initState();
    _printerChoice = PrinterPreference.getDefault();
    _bothMode = PrinterPreference.getBothMode();
    _selectedMac = PrinterPreference.getBluetoothAddress();
    if (_needsBluetooth) {
      _loadPairedDevices();
    }
  }

  bool get _needsBluetooth => _printerChoice != PrinterChoice.builtin;

  Future<void> _loadPairedDevices() async {
    setState(() => _loadingDevices = true);
    final devices = await BluetoothPrinterHelper.getPairedDevices();
    if (!mounted) return;
    setState(() {
      _pairedDevices = devices;
      _loadingDevices = false;
    });
  }

  void _onChoiceChanged(PrinterChoice? choice) {
    if (choice == null) return;
    setState(() => _printerChoice = choice);
    PrinterPreference.setDefault(choice);
    if (choice != PrinterChoice.builtin && _pairedDevices.isEmpty) {
      _loadPairedDevices();
    }
  }

  void _onBothModeChanged(PrintBothMode? mode) {
    if (mode == null) return;
    setState(() => _bothMode = mode);
    PrinterPreference.setBothMode(mode);
  }

  void _onDeviceSelected(BluetoothInfo device) {
    setState(() => _selectedMac = device.macAdress);
    PrinterPreference.setBluetoothDevice(device.macAdress, device.name);
  }

  Future<void> _testPrint() async {
    await BluetoothPrinterHelper.printReceipt(const {
      'businessName': 'Geepay',
      'branchName': 'Test Branch',
      'username': 'Test Cashier',
      'amount': '10.00',
      'phone': '0000000000',
      'paymentChannel': 'Test',
      'transactionId': 'TEST-0001',
      'date': '',
      'status': 'successful',
      'isReprint': 'false',
      'reprintCount': '1',
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: APPAPPBar(
        showBackArrow: true,
        title: Text('Printer Settings', style: Theme.of(context).textTheme.headlineSmall),
      ),
      body: ListView(
        padding: const EdgeInsets.all(APPSizes.defaultSpace),
        children: [
          Text('Default Printer', style: Theme.of(context).textTheme.titleMedium),
          RadioListTile<PrinterChoice>(
            title: const Text('Built-in Printer'),
            value: PrinterChoice.builtin,
            groupValue: _printerChoice,
            onChanged: _onChoiceChanged,
          ),
          RadioListTile<PrinterChoice>(
            title: const Text('Bluetooth Printer'),
            value: PrinterChoice.bluetooth,
            groupValue: _printerChoice,
            onChanged: _onChoiceChanged,
          ),
          RadioListTile<PrinterChoice>(
            title: const Text('Both'),
            value: PrinterChoice.both,
            groupValue: _printerChoice,
            onChanged: _onChoiceChanged,
          ),
          if (_printerChoice == PrinterChoice.both) ...[
            const SizedBox(height: APPSizes.spaceBtwItem),
            Text('When printing to both', style: Theme.of(context).textTheme.titleMedium),
            RadioListTile<PrintBothMode>(
              title: const Text('Print one after the other'),
              value: PrintBothMode.sequential,
              groupValue: _bothMode,
              onChanged: _onBothModeChanged,
            ),
            RadioListTile<PrintBothMode>(
              title: const Text('Print simultaneously'),
              value: PrintBothMode.simultaneous,
              groupValue: _bothMode,
              onChanged: _onBothModeChanged,
            ),
          ],
          if (_needsBluetooth) ...[
            const SizedBox(height: APPSizes.spaceBtwSections),
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceBetween,
              children: [
                Text('Paired Bluetooth Devices', style: Theme.of(context).textTheme.titleMedium),
                IconButton(
                  onPressed: _loadPairedDevices,
                  icon: const Icon(Icons.refresh),
                ),
              ],
            ),
            if (_loadingDevices)
              const Padding(
                padding: EdgeInsets.all(APPSizes.defaultSpace),
                child: Center(child: CircularProgressIndicator()),
              )
            else if (_pairedDevices.isEmpty)
              const Padding(
                padding: EdgeInsets.symmetric(vertical: APPSizes.spaceBtwItem),
                child: Text(
                    'No paired Bluetooth devices found. Pair a printer in your device Bluetooth settings first, then refresh.'),
              )
            else
              ..._pairedDevices.map(
                (device) => RadioListTile<String>(
                  title: Text(device.name),
                  subtitle: Text(device.macAdress),
                  value: device.macAdress,
                  groupValue: _selectedMac,
                  onChanged: (_) => _onDeviceSelected(device),
                ),
              ),
            if (_selectedMac != null) ...[
              const SizedBox(height: APPSizes.spaceBtwItem),
              SizedBox(
                width: double.infinity,
                child: ElevatedButton(
                  onPressed: _testPrint,
                  child: const Text('Test Print'),
                ),
              ),
            ],
          ],
        ],
      ),
    );
  }
}
```

This one depends on `APPAPPBar` (a custom app bar widget) and `APPSizes`
(spacing constants) — replace those two with the new project's own
equivalents, or drop them for plain `AppBar`/hardcoded padding.

