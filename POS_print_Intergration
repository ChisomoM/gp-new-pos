            bitmapFormat.setAlign(PrintAlign.FORMAT_ALIGN_CENTER);
            printerDevice.printText(
                    getTextFormat(PrintAlign.FORMAT_ALIGN_CENTER, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                    "Powered by ");
            printerDevice.printBitmap(bitmapFormat, resizedBitmap);
        }

        printerDevice.printText(null, "\n\n");
        printerDevice.printText(null, "\n\n\n\n\n");

        printerDevice.startPrint(new OnPrintTaskListener() {
            @Override
            public void onPrintResult(int i) {
                runOnUiThread(() -> {
                    if (i == PrinterConstants.TASK_STATUS_SUCCESS) {
                        result.success("Zesco receipt printed successfully");
                    } else {
                        result.error("PRINT_FAILED", "Failed to print Zesco receipt", null);
                    }
                });
            }
        });
    } else {
        result.error("UNAVAILABLE", "Printer not available", null);
    }
}

private void printDailySummary(List<Map<String, String>> transactions, MethodChannel.Result result) {
    AidlPrinter topwisePrinter = TopwisePrinterHelper.getPrinterIfAvailable();
    if (topwisePrinter != null) {
        TopwisePrinterHelper.printDailySummary(this, topwisePrinter, transactions, result);
        return;
    }
    if (printerDevice != null) {
        printerDevice.clear();

        int successCount = 0;
        double totalAmount = 0.0;
        int failedCount = 0;
        int totalCount = 0;
        int pendingCount = 0;

        printerDevice.printText(
                getTextFormat(PrintAlign.FORMAT_ALIGN_CENTER, PrintFontSize.FORMAT_FONT_SIZE_LARGE),
                "Daily Transaction Summary\n\n");

        for (Map<String, String> txn : transactions) {
            totalCount++;

            printerDevice.printText(
                    getTextFormat(PrintAlign.FORMAT_ALIGN_LEFT, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                    "Business: " + txn.get("businessName") + "\n\n");
            printerDevice.printText(
                    getTextFormat(PrintAlign.FORMAT_ALIGN_LEFT, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                    "Cashier: " + txn.get("cashier") + "\n\n");
            printerDevice.printText(
                    getTextFormat(PrintAlign.FORMAT_ALIGN_LEFT, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                    "ID: " + txn.get("transactionId") + "\n\n");
            printerDevice.printText(
                    getTextFormat(PrintAlign.FORMAT_ALIGN_LEFT, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                    "Amount: " + "K" + txn.get("amount") + "\n\n");
            printerDevice.printText(
                    getTextFormat(PrintAlign.FORMAT_ALIGN_LEFT, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                    "Network: " + txn.get("network") + "\n\n");
            printerDevice.printText(
                    getTextFormat(PrintAlign.FORMAT_ALIGN_LEFT, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                    "Status: " + txn.get("status") + "\n\n");
            printerDevice.printText(
                    getTextFormat(PrintAlign.FORMAT_ALIGN_LEFT, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                    "Date: " + txn.get("date") + "\n\n");

            printerDevice.printDottedLines(null, 1);
            printerDevice.printText(null, "\n\n");

            String status = txn.get("status");
            String amountStr = txn.get("amount");

            if ("successful".equalsIgnoreCase(status)) {
                try {
                    double amt = Double.parseDouble(amountStr);
                    totalAmount += amt;
                    successCount++;
                } catch (NumberFormatException e) {
                    // log or skip
                }
            } else if ("failed".equalsIgnoreCase(status)) {
                failedCount++;
            } else {
                pendingCount++;
            }
        }

        printerDevice.printText(
                getTextFormat(PrintAlign.FORMAT_ALIGN_LEFT, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                "\n--- Summary Totals ---\n" + "\n\n");
        printerDevice.printText(
                getTextFormat(PrintAlign.FORMAT_ALIGN_LEFT, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                "Total Transactions: " + totalCount + "\n\n");
        printerDevice.printText(
                getTextFormat(PrintAlign.FORMAT_ALIGN_LEFT, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                "Successful Transactions: " + successCount + "\n\n");
        printerDevice.printText(
                getTextFormat(PrintAlign.FORMAT_ALIGN_LEFT, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                "Failed Transactions: " + failedCount + "\n\n");
        printerDevice.printText(
                getTextFormat(PrintAlign.FORMAT_ALIGN_LEFT, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                String.format("Total Amount(Successful): ZMW %.2f\n", totalAmount));
        printerDevice.printText(null, "\n\n");
        printerDevice.printText(
                getTextFormat(PrintAlign.FORMAT_ALIGN_CENTER, PrintFontSize.FORMAT_FONT_SIZE_MEDIUM),
                "Thank you!\n\n\n");
        printerDevice.printText(null, "\n\n");
        printerDevice.startPrint(new OnPrintTaskListener() {
            @Override
            public void onPrintResult(int i) {
                runOnUiThread(() -> {
                    if (i == PrinterConstants.TASK_STATUS_SUCCESS) {
                        result.success("Summary printed");
                    } else {
                        result.error("PRINT_FAILED", "Could not print summary", null);
                    }
                });
            }
        });
    } else {
        result.error("UNAVAILABLE", "Printer not available", null);
    }
}

private TextFormat getTextFormat(PrintAlign align, int fontSize) {
    TextFormat format = new TextFormat();
    format.setAlign(align);
    format.setFontSize(fontSize);
    return format;
}
```

> These three methods and `getTextFormat` already exist standalone in
> `PrinterHelper.java` (section 3d) — `MainActivity.java`'s copies predate
> that extraction and were kept as-is precisely so the Trendit path stayed
> "untouched" while Topwise support was bolted on. When porting to a new
> project, either keep both copies (matching this app's history) or
> consolidate onto `PrinterHelper.java` and call it from `MainActivity`
> instead — behaviorally identical either way.

