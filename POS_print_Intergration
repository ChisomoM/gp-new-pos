private void setupPrintChannel(FlutterEngine flutterEngine) {
    new MethodChannel(flutterEngine.getDartExecutor().getBinaryMessenger(), PRINT_CHANNEL).setMethodCallHandler(
            (call, result) -> {
                if (call.method.equals("printReceipt")) {
                    Map<String, String> arguments = call.arguments();
                    printReceipt(arguments, result);
                } else if (call.method.equals("printZesco")) {
                    Map<String, String> arguments = call.arguments();
                    printZescoReceipt(arguments, result);
                } else if (call.method.equals("printDailySummary")) {
                    List<Map<String, String>> transactions = call.arguments();
                    printDailySummary(transactions, result);
                } else {
                    result.notImplemented();
                }
            });
}
